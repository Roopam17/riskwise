# Copy this file to .env.local and fill in what you have. Everything is optional for local development.

# Where the backend lives. Leave empty in development (Vite forwards /api to localhost:8000).
# After deploying, put your Render address here, e.g. https://riskwise-api.onrender.com
VITE_API_BASE=

# Supabase (login + watchlist). Without these the app runs in "local mode":
# the watchlist is saved in this browser only and the login page explains it is not connected.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Show the "Log in with Google" button once Google login is switched on in Supabase.
VITE_ENABLE_GOOGLE=false

# Shown on the About page so people can send feedback.
VITE_CONTACT_EMAIL=
